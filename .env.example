# Supply the token through the host's secret/environment mechanism. Never commit it.
DISCORD_BOT_TOKEN=
# Decimal Discord IDs, comma separated. No wildcards or implicit child threads.
DISCORD_GUILD_IDS=
DISCORD_CHANNEL_IDS=
DISCORD_ENABLE_WRITES=false
# Required subset of DISCORD_CHANNEL_IDS only when writes are enabled.
DISCORD_WRITE_CHANNEL_IDS=
